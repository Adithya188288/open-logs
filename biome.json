{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "public/**",
      "test/**",
      "e2e/**",
      "scripts/**",
      "site/**",
      "create-open-logs/**",
      "*.js",
      "*.json",
      "!docs",
      "!e2e/.auth"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off" },
      "a11y": { "noSvgWithoutTitle": "off" }
    }
  },
  "assist": { "enabled": false }
}
