  "narrative": {
    "northStar": "The Control Room",
    "overview": "Open Logs is the screen an on-call engineer keeps open through an incident: calm, dense and precise, readable for hours, with nothing on it that isn't information. Data leads and the chrome recedes. Colour is reserved for state.",
    "keyCharacteristics": ["Monochrome shell; colour only for log levels, status, focus and chart series.", "Flat surfaces with hairline borders; shadows only on floating layers.", "Geist for UI, Geist Mono for timestamps, fields, values, tokens and code.", "Dense by default: 13px body, compact rows, small controls.", "Light and dark themes are equals."],
    "rules": [
      { "name": "The Colour Means State Rule", "body": "Every coloured pixel answers \"what state is this in?\" Level, status, focus or a chart series. Decoration stays grey.", "section": "colors" },
      { "name": "The Quiet Info Rule", "body": "Info and debug render grey; only warn and error get colour, so the eye goes to trouble.", "section": "colors" },
      { "name": "The Machine Wrote It Rule", "body": "If a machine produced the text (a timestamp, a field, a value, a token), it is set in Geist Mono. Human-written copy never is.", "section": "typography" },
      { "name": "The Flat Floor Rule", "body": "Anything attached to the page has a border and no shadow. Only things that float get the Float shadow.", "section": "elevation" }
    ],
    "dos": ["Do set every timestamp, field, value, token and count in Geist Mono.", "Do keep info and debug grey; reserve red and amber for error and warn.", "Do use the 6px radius for controls and 10px for containers.", "Do give every interactive element hover, focus-visible, disabled and, where relevant, loading and empty states.", "Do check every change in both light and dark themes."],
    "donts": ["Don't add shadows to cards, tiles or tables; borders carry depth.", "Don't introduce a decorative accent colour or gradients.", "Don't use spinners between screens; data is loaded once.", "Don't use monospace for headings, labels or human-written copy.", "Don't use pills for anything except small status badges."]
  }
