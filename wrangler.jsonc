{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-logs",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/v1/*", "/api/*"]
  },
  // No database_id: wrangler creates the D1 database on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-logs",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } }
  ],
  "vars": {
    "LOG_STORAGE": "local",
    "TEAM_NAME": "Open Logs"
  },
  // Production-style deploy on Basin. Fill the ids printed by `node scripts/setup-basin.js`.
  // Secrets: wrangler secret put ADMIN_PASSWORD --env staging; wrangler secret put BASIN_SQL_TOKEN --env staging
  "env": {
    "staging": {
      "name": "open-logs-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "open-logs-staging", "migrations_dir": "migrations" }
      ],
      "pipelines": [{ "binding": "LOG_STREAM", "stream": "REPLACE_WITH_STREAM_ID" }],
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } }
      ],
      "vars": {
        "LOG_STORAGE": "basin",
        "TEAM_NAME": "Open Logs",
        "BASIN_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "BASIN_BUCKET": "open-logs",
        "BASIN_TABLE": "open_logs.events"
      }
    }
  }
}
