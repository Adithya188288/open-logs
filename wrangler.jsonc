{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "open-logs",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	// The once-a-minute alert check.
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/v1/*",
			"/api/*"
		]
	},
	// App data only (users, projects, sources, dashboards). Logs never go to D1.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "open-logs",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "LOGIN_IP_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "INGEST_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 1200,
				"period": 60
			}
		}
	],
	// Logs: a Basin (Cloudflare Pipelines) stream. `npm run setup` creates it and writes each install's real ids
	// into .open-logs/<name>.jsonc (gitignored); this file is the template, and what the tests run against.
	"pipelines": [
		{
			"binding": "LOG_STREAM",
			"stream": "created-by-npm-run-setup"
		}
	],
	"vars": {
		"TEAM_NAME": "Open Logs",
		"BASIN_ACCOUNT_ID": "",
		"BASIN_BUCKET": "",
		"BASIN_TABLE": "open_logs.events"
	}
}
