{
  "name": "open-logs",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted log management for your own Cloudflare account.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "update": "node scripts/update.js",
    "rollback": "node scripts/rollback.js",
    "uninstall": "node scripts/uninstall.js",
    "deploy:staging": "node scripts/staging.js deploy",
    "staging:reset": "node scripts/staging.js reset",
    "dev": "node -e \"console.log('Open Logs runs on Cloudflare only: logs live in Basin, which has no local version.\\nInstall it: npm run setup   Test a branch on your test install: npm run deploy:staging')\"",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
