{
  "name": "open-logs",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, self-hosted log management for your own Cloudflare account.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "update": "node scripts/update.js",
    "rollback": "node scripts/rollback.js",
    "uninstall": "node scripts/uninstall.js",
    "deploy": "node scripts/deploy.js",
    "reset": "node scripts/deploy.js --reset",
    "destroy": "node scripts/uninstall.js --branch",
    "verify": "playwright test",
    "demo-data": "node scripts/demo-data.js",
    "dev": "node -e \"console.log('Open Logs runs on Cloudflare only: logs live in Basin, which has no local version.\\nInstall it: npm run setup   Developers: npm run deploy <install name>')\"",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
